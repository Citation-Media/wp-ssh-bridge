#!/usr/bin/env bash
# Drives the end-to-end environment for wp-ssh-bridge. See e2e/README.md.
#
# Everything generated (keys, binaries, projects) lives in e2e/.state, which
# is ignored by Git. Compatible with the Bash 3.2 macOS ships.
set -euo pipefail

E2E_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$E2E_DIR/.." && pwd)
STATE="$E2E_DIR/.state"

SOURCE_PORT=${WPSB_E2E_SOURCE_PORT:-22221}
LEGACY_PORT=${WPSB_E2E_LEGACY_PORT:-22222}
TARGET_PORT=${WPSB_E2E_TARGET_PORT:-22223}
WPENV_PORT=${WPSB_E2E_WPENV_PORT:-8920}

usage() {
    cat <<'EOF'
Usage: e2e/wpsb-e2e <command> [args]

Stack
  up                 Build the CLI and the image, start the hosts, seed them
  build              Rebuild the CLI for the host and for the containers
  seed [machine...]  Reset source, target, workstation (default: all three)
  down [--volumes]   Stop the hosts; --volumes also drops sites and databases
  status             Show the containers and the SSH aliases
  logs [service]     Show container logs

Using it
  env                Print exports for your shell: eval "$(e2e/wpsb-e2e env)"
  run <cmd...>       Run a command with the E2E ssh and CLI on PATH
  ssh <alias> [cmd]  SSH into wpsb-source, wpsb-legacy, or wpsb-target
  exec <machine> [cmd...]
                     Shell (as the site user) on source, legacy, target,
                     or workstation
  wp <machine> [args...]
                     WP-CLI on a machine's site (workstation: /work/public)

Local runtimes
  ddev [init|pull|native|report|rm]
                     Direct or native pull into a DDEV project in
                     e2e/.state/projects/ddev
  wp-env [init|pull|report|rm]
                     Pull into a wp-env project in e2e/.state/projects/wp-env

Checks
  test [suite|scenario...]
                     Run scenarios; suites are containers (the default),
                     ddev, wp-env, and all. `test --list` lists them.
EOF
}

log() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

compose() { docker compose --project-directory "$E2E_DIR" -f "$E2E_DIR/compose.yaml" "$@"; }

# --- keys, ssh, binaries ------------------------------------------------------

ensure_keys() {
    mkdir -p "$STATE/keys"
    [ -f "$STATE/keys/id_ed25519" ] ||
        ssh-keygen -q -t ed25519 -N '' -C wpsb-e2e-login -f "$STATE/keys/id_ed25519"
    [ -f "$STATE/keys/ssh_host_ed25519_key" ] ||
        ssh-keygen -q -t ed25519 -N '' -C wpsb-e2e-host -f "$STATE/keys/ssh_host_ed25519_key"
    printf 'wpsb-e2e %s\n' "$(cut -d' ' -f1,2 "$STATE/keys/ssh_host_ed25519_key.pub")" > "$STATE/known_hosts"
}

# The CLI calls plain `ssh`, and rsync does too. A wrapper first on PATH points
# both at an isolated config, so the E2E aliases work without touching
# ~/.ssh/config, known_hosts, or the SSH agent.
write_ssh_config() {
    mkdir -p "$STATE/bin"
    cat > "$STATE/ssh_config" <<EOF
Host wpsb-source
    Port $SOURCE_PORT
Host wpsb-legacy
    Port $LEGACY_PORT
Host wpsb-target
    Port $TARGET_PORT
Host wpsb-*
    HostName 127.0.0.1
    User site
    HostKeyAlias wpsb-e2e
    IdentityFile $STATE/keys/id_ed25519
    IdentitiesOnly yes
    IdentityAgent none
    UserKnownHostsFile $STATE/known_hosts
    StrictHostKeyChecking yes
EOF
    local real_ssh
    real_ssh=$(PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$STATE/bin" | paste -sd: -) command -v ssh) ||
        die "ssh not found on PATH"
    cat > "$STATE/bin/ssh" <<EOF
#!/bin/sh
exec "$real_ssh" -F "$STATE/ssh_config" "\$@"
EOF
    chmod +x "$STATE/bin/ssh"
}

build_cli() {
    command -v go > /dev/null || die "go is required to build the CLI"
    local arch commit ldflags
    arch=$(docker version --format '{{.Server.Arch}}')
    commit=$(git -C "$REPO_DIR" rev-parse --short HEAD 2> /dev/null || echo unknown)
    ldflags="-X github.com/Citation-Media/wp-ssh-bridge/internal/version.Version=e2e-$commit"
    log "Building wp-ssh-bridge for this machine and for linux/$arch"
    mkdir -p "$STATE/bin/linux"
    (cd "$REPO_DIR" && go build -ldflags "$ldflags" -o "$STATE/bin/wp-ssh-bridge" ./cmd/wp-ssh-bridge)
    (cd "$REPO_DIR" && CGO_ENABLED=0 GOOS=linux GOARCH="$arch" go build -ldflags "$ldflags" -o "$STATE/bin/linux/wp-ssh-bridge" ./cmd/wp-ssh-bridge)
}

prepare() {
    ensure_keys
    write_ssh_config
}

# Runs a command with the wrapper and the host CLI first on PATH.
with_env() { PATH="$STATE/bin:$PATH" WPSB_E2E_STATE="$STATE" "$@"; }

# --- containers -----------------------------------------------------------------

in_machine() { # machine cmd...
    local machine=$1
    shift
    compose exec -T -u site "$machine" "$@"
}

wait_for_ssh() {
    local alias
    for alias in wpsb-source wpsb-legacy wpsb-target; do
        local tries=0
        until with_env ssh -o BatchMode=yes -o ConnectTimeout=2 "$alias" true 2> /dev/null; do
            tries=$((tries + 1))
            [ "$tries" -lt 30 ] || die "$alias does not accept SSH logins; see: e2e/wpsb-e2e logs"
            sleep 1
        done
    done
}

seed() {
    local machines=("$@")
    [ ${#machines[@]} -gt 0 ] || machines=(source target workstation)
    local machine
    for machine in "${machines[@]}"; do
        case "$machine" in
            source) log "Seeding the source (shared with legacy)"; in_machine source wpsb-seed source ;;
            target) log "Emptying the target"; in_machine target wpsb-seed target ;;
            target-config) log "Preparing the target as a new host (core and wp-config.php, no site)"; in_machine target wpsb-seed target-config "${SEED_PREFIX:-abc_}" ;;
            target-site) log "Installing a site on the target"; in_machine target wpsb-seed target-site "${SEED_PREFIX:-wp_}" ;;
            workstation) log "Seeding the workstation"; in_machine workstation wpsb-seed workstation ;;
            *) die "unknown machine: $machine (source, target, target-config, target-site, workstation)" ;;
        esac
    done
}

cmd_up() {
    command -v docker > /dev/null || die "docker is required"
    prepare
    build_cli
    log "Starting the hosts"
    compose up -d --build --wait
    wait_for_ssh
    seed
    cmd_status
}

cmd_status() {
    compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Ports}}'
    cat <<EOF

SSH aliases (through e2e/wpsb-e2e run/env):
  wpsb-source  127.0.0.1:$SOURCE_PORT  /var/www/site  rsync, current MariaDB client
  wpsb-legacy  127.0.0.1:$LEGACY_PORT  /var/www/site  same site, no rsync, exec() disabled, legacy MariaDB names
  wpsb-target  127.0.0.1:$TARGET_PORT  /var/www/site  push and clone target
EOF
}

cmd_wp() {
    [ $# -ge 1 ] || die "usage: wp <machine> [args...]"
    local machine=$1 path=/var/www/site
    shift
    [ "$machine" = workstation ] && path=/work/public
    in_machine "$machine" wp --path="$path" "$@"
}

# --- main -------------------------------------------------------------------------

main() {
    local cmd=${1:-help}
    [ $# -eq 0 ] || shift
    case "$cmd" in
        up) cmd_up ;;
        build) build_cli ;;
        seed) seed "$@" ;;
        down)
            if [ "${1:-}" = --volumes ]; then compose down --volumes; else compose down; fi
            ;;
        status) cmd_status ;;
        logs) compose logs "$@" ;;
        env)
            prepare
            # $PATH stays literal: the caller's shell expands it.
            # shellcheck disable=SC2016
            printf 'export PATH=%q:"$PATH"\nexport WPSB_E2E_STATE=%q\n' "$STATE/bin" "$STATE"
            ;;
        run)
            prepare
            with_env "$@"
            ;;
        ssh)
            prepare
            with_env ssh "$@"
            ;;
        exec)
            [ $# -ge 1 ] || die "usage: exec <machine> [cmd...]"
            local machine=$1
            shift
            if [ $# -eq 0 ]; then compose exec -u site "$machine" bash; else compose exec -u site "$machine" "$@"; fi
            ;;
        wp) cmd_wp "$@" ;;
        ddev)
            # shellcheck source=lib/projects.sh
            source "$E2E_DIR/lib/projects.sh"
            cmd_ddev "$@"
            ;;
        wp-env)
            # shellcheck source=lib/projects.sh
            source "$E2E_DIR/lib/projects.sh"
            cmd_wpenv "$@"
            ;;
        test)
            # shellcheck source=lib/scenarios.sh
            source "$E2E_DIR/lib/scenarios.sh"
            cmd_test "$@"
            ;;
        help | -h | --help) usage ;;
        *) usage >&2; exit 2 ;;
    esac
}

main "$@"

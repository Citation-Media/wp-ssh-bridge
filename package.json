{
  "name": "wp-ssh-bridge-monorepo",
  "private": true,
  "description": "Monorepo for the wp-ssh-bridge CLI and its documentation site.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "docs:dev": "npm run dev --workspace @wp-ssh-bridge/documentation",
    "docs:build": "npm run build --workspace @wp-ssh-bridge/documentation",
    "docs:preview": "npm run preview --workspace @wp-ssh-bridge/documentation",
    "docs:check": "npm run check --workspace @wp-ssh-bridge/documentation",
    "docs:validate": "npm run validate --workspace @wp-ssh-bridge/documentation",
    "skill:pack": "apm pack && cp .claude-plugin/marketplace.json packages/documentation/public/marketplace.json",
    "npm:check": "npm run prepublishOnly --workspace @citation-media/wp-ssh-bridge",
    "npm:publish": "npm publish --access public --workspace @citation-media/wp-ssh-bridge"
  }
}

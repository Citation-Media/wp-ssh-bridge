{
  "name": "@wp-ssh-bridge/documentation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for wp-ssh-bridge. Reads the MDX content from the repository's docs/ folder and deploys to Cloudflare Workers.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "blume dev",
    "build": "blume build",
    "preview": "blume preview",
    "check": "blume check",
    "validate": "blume validate",
    "deploy": "wrangler deploy --config dist/server/wrangler.json --name wp-ssh-bridge-docs",
    "deploy:preview": "wrangler versions upload --config dist/server/wrangler.json --name wp-ssh-bridge-docs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "astro": "^7.3.3",
    "blume": "^1.7.0",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "wrangler": "^4.132.0"
  }
}
